rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users Collection
    // Anyone can read profiles. Users can only write to their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Posts Collection
    // Anyone can read posts. Authenticated students can create posts.
    // Authors can edit or delete their own posts. Admins can moderate/delete any post.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 3000;
      allow update: if isAuthenticated() && (
        // Allow author to update content
        (request.resource.data.authorId == request.auth.uid && resource.data.authorId == request.auth.uid) ||
        // Allow liking/unliking or commenting
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'sharesCount'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // Opportunities Collection
    // Publicly readable. Authenticated users/admins can create or manage.
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Circles Collection
    match /circles/{circleId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Research Hub Collection
    match /research/{researchId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // Conversations & Messages
    // Only conversation participants can read/write messages
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Notifications Collection
    // Only recipient can read or update their own notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // Reports Collection
    // Any authenticated student can submit a report. Only admins can read or resolve reports.
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
